# Application
NODE_ENV=staging
PORT=4000

# Database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nova_rio_staging
POSTGRES_USER=<staging_user>
POSTGRES_PASSWORD=<staging_password>
# Prisma connection string (derived from values above)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Cache
REDIS_HOST=redis
REDIS_PORT=6379

# Auth / Security
JWT_SECRET="staging-jwt-secret"
JWT_EXPIRES_IN="1h"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxx"
RESEND_FROM_EMAIL="Nova Rio <noreply@novario.com>"

