generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum AdminRole {
  ADMIN_MASTER
  ADMIN_BASIC
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  APPROVED
  PENDING
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PIX
}

enum RecurrenceType {
  SINGLE       // Avulso
  PACKAGE      // Pacote
  WEEKLY       // Semanal
  BIWEEKLY     // Quinzenal
  MONTHLY      // Mensal
}

enum ServiceRecurrenceFrequency {
  WEEKLY       // Semanal
  BIWEEKLY     // Quinzenal
  MONTHLY      // Mensal
}

enum PaymentOption {
  SINGLE
  PACKAGE
  RECURRENCE
}

enum HolidayType {
  NATIONAL
  STATE
  MUNICIPAL
  FACULTATIVO
}

// ============================================================
// ADMIN USERS (Painel Admin)
// ============================================================

model AdminUser {
  id        Int         @id @default(autoincrement())
  uuid      String      @unique @default(uuid())
  name      String
  email     String      @unique
  password  String
  role      AdminRole   @default(ADMIN_BASIC)
  status    UserStatus  @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  refreshToken        String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  tokenFamily         String?

  // Admin master que criou este admin
  createdBy   AdminUser?  @relation("AdminCreator", fields: [createdById], references: [id])
  createdById Int?
  createdAdmins AdminUser[] @relation("AdminCreator")

  @@index([createdById])
  @@map("admin_users")
}

model AdminVerificationCode {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  code      String
  type      String   // EMAIL_CHANGE, PASSWORD_CHANGE
  channel   String   // EMAIL
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  adminId Int

  @@index([adminId, type])
  @@map("admin_verification_codes")
}

// ============================================================
// CLIENTS (Usuários do app/web)
// ============================================================

model Client {
  id          Int        @id @default(autoincrement())
  uuid        String     @unique @default(uuid())
  name        String
  email       String     @unique
  phone       String?
  password    String
  avatarUrl   String?
  company     String?
  cpfCnpj     String?    @unique
  address     String?
  complement  String?

  // Preferência de recorrência padrão do cliente (pré-seleciona no agendamento)
  preferredRecurrence ServiceRecurrenceFrequency?

  refreshToken        String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  failedResetAttempts Int       @default(0)
  resetLockedUntil    DateTime?
  tokenFamily         String?
  status              UserStatus @default(PENDING)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  appointments Appointment[]
  payments     Payment[]
  cards        Card[]
  unit         Unit?        @relation(fields: [unitId], references: [id])
  unitId       Int?

  vindiCustomerId Int?

  verificationCodes VerificationCode[]

  @@index([unitId])
  @@map("clients")
}

// ============================================================
// CARDS (Cartões salvos do cliente)
// ============================================================

model Card {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @default(uuid())
  lastFourDigits String
  brand          String   // visa, mastercard, elo, amex, hipercard
  holderName     String
  expiryMonth    Int
  expiryYear     Int
  gatewayToken   String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId Int

  payments Payment[]

  @@index([clientId])
  @@map("cards")
}

// ============================================================
// EMPLOYEES (Funcionários)
// ============================================================

model Employee {
  id               Int            @id @default(autoincrement())
  uuid             String         @unique @default(uuid())
  name             String
  email            String         @unique
  phone            String?
  cpf              String         @unique
  address          String?
  avatarUrl        String?
  status           EmployeeStatus @default(ACTIVE)
  availabilityFrom String?        // Horário inicial ex: "08:00"
  availabilityTo   String?        // Horário final ex: "18:00"
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  unit   Unit?   @relation(fields: [unitId], references: [id])
  unitId Int?

  appointments Appointment[]

  @@index([unitId])
  @@map("employees")
}

// ============================================================
// UNITS (Unidades)
// ============================================================

model Unit {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  name            String   @unique
  address         String?
  street          String?  @map("street")
  number          String?  @map("number")
  neighborhood    String?  @map("neighborhood")
  city            String?  @map("city")
  state           String?  @map("state")
  cep             String?  @map("cep")
  latitude        Float?
  longitude       Float?
  serviceRadiusKm Float    @default(5) @map("service_radius_km")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employees    Employee[]
  clients      Client[]
  appointments Appointment[]

  @@map("units")
}

// ============================================================
// SERVICES (Tipos de serviço - Faxina Regular, Premium, etc.)
// ============================================================

model Service {
  id          Int     @id @default(autoincrement())
  uuid        String  @unique @default(uuid())
  name        String
  description String?
  icon        String? // Identificador do ícone
  basePrice       Decimal  @db.Decimal(10, 2)
  durationMinutes  Int      @default(120) // Duração padrão em minutos

  // Opções de pagamento habilitadas
  allowSingle     Boolean @default(true)  // Avulso
  allowPackage    Boolean @default(false)  // Pacote
  allowRecurrence Boolean @default(false)  // Recorrência

  // Frequências de recorrência habilitadas (válidas quando allowRecurrence)
  recurrenceFrequencies ServiceRecurrenceFrequency[] @default([WEEKLY, BIWEEKLY, MONTHLY])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  packages     Package[]

  @@map("services")
}

// ============================================================
// PACKAGES (Pacotes de serviço)
// ============================================================

model Package {
  id          Int     @id @default(autoincrement())
  uuid        String  @unique @default(uuid())
  name        String
  description String?
  totalHours  Int?
  price       Decimal @db.Decimal(10, 2)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service   Service @relation(fields: [serviceId], references: [id])
  serviceId Int

  appointments Appointment[]

  @@index([serviceId])
  @@map("packages")
}

// ============================================================
// APPOINTMENTS (Agendamentos)
// ============================================================

model Appointment {
  id             Int               @id @default(autoincrement())
  uuid           String            @unique @default(uuid())
  date           DateTime          @db.Date
  startTime      String            // Ex: "09:00"
  duration       Int               // Duração em minutos
  status         AppointmentStatus @default(SCHEDULED)
  recurrenceType RecurrenceType    @default(SINGLE)
  weeklyFrequency Int              @default(1) // Vezes por semana (1-7), aplicável quando WEEKLY
  locationZip    String?           // CEP do local
  locationAddress String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId Int

  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId Int?

  service   Service @relation(fields: [serviceId], references: [id])
  serviceId Int

  package   Package? @relation(fields: [packageId], references: [id])
  packageId Int?

  unit   Unit? @relation(fields: [unitId], references: [id])
  unitId Int?

  payment Payment?

  @@index([date])
  @@index([status])
  @@index([clientId])
  @@index([employeeId])
  @@index([employeeId, date, status])
  @@index([unitId])
  @@index([clientId, status])
  @@map("appointments")
}

// ============================================================
// PAYMENTS (Pagamentos)
// ============================================================

model Payment {
  id              Int           @id @default(autoincrement())
  uuid            String        @unique @default(uuid())
  amount          Decimal       @db.Decimal(10, 2)
  subtotal        Decimal       @db.Decimal(10, 2)
  serviceFee      Decimal       @default(0) @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  cancellationReason String?
  chargeAttempts  Int           @default(0) // Tentativas de cobrança rejeitadas pelo gateway
  gatewayTransactionId String?  @unique // ID da transação no gateway
  pixCode         String?       // Código PIX quando aplicável
  pixQrCodeUrl    String?       // URL do QR Code PIX
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId Int

  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId Int         @unique

  card   Card?   @relation(fields: [cardId], references: [id])
  cardId Int?

  receipt Receipt?

  @@index([status])
  @@index([clientId])
  @@map("payments")
}

// ============================================================
// RECEIPTS (Recibos)
// ============================================================

model Receipt {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  fileUrl   String   // URL do PDF/arquivo do recibo
  createdAt DateTime @default(now())

  payment   Payment @relation(fields: [paymentId], references: [id])
  paymentId Int     @unique

  @@map("receipts")
}

// ============================================================
// HOLIDAYS (Feriados - para bloquear no calendário)
// ============================================================

model Holiday {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  date      DateTime @db.Date
  name      String
  type      HolidayType @default(NATIONAL)
  isBlocked Boolean  @default(true) @map("is_blocked")

  @@unique([date])
  @@map("holidays")
}

// ============================================================
// ADMIN NOTIFICATION SETTINGS (Configurações de notificação admin)
// ============================================================

model AdminNotificationSetting {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  email     String   @unique
  events    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_notification_settings")
}

model ProcessedWebhookEvent {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique
  provider  String
  createdAt DateTime @default(now())

  @@map("processed_webhook_events")
}

// ============================================================
// VERIFICATION CODES (Códigos de verificação SMS/WhatsApp)
// ============================================================

model VerificationCode {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  code      String
  type      String   // EMAIL_CHANGE, PASSWORD_CHANGE
  channel   String   // SMS, WHATSAPP
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  client   Client @relation(fields: [clientId], references: [id])
  clientId Int

  @@index([clientId, type])
  @@map("verification_codes")
}
