# Application
NODE_ENV=production
PORT=3000

# Database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nova_rio_prod
POSTGRES_USER=<prod_user>
POSTGRES_PASSWORD=<prod_password>
# Prisma connection string (derived from values above)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<redis_password>

# Auth / Security
JWT_SECRET="prod-jwt-secret"
JWT_REFRESH_SECRET="prod-jwt-refresh-secret"
JWT_EXPIRES_IN="1h"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxx"
RESEND_FROM_EMAIL="Nova Rio <noreply@novario.com>"

# Payment Gateway (Vindi)
VINDI_API_KEY="your-vindi-api-key"
VINDI_API_URL="https://app.vindi.com.br/api/v1"
VINDI_PRODUCT_ID=1

# Database Pool
DATABASE_POOL_SIZE=10

# CORS
CORS_ORIGIN="https://app.novario.com"

