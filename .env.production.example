# Application
NODE_ENV=production
PORT=3000

# Database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nova_rio
POSTGRES_USER=<prod_user>
POSTGRES_PASSWORD=<prod_password>
# Prisma connection string (derived from values above)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Database Pool
DATABASE_POOL_SIZE=10

# Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<redis_password_or_empty>

# Auth / Security
JWT_SECRET="<long-random-secret>"
JWT_REFRESH_SECRET="<long-random-refresh-secret>"
JWT_EXPIRES_IN="1h"

# Admin user (seeded on first startup)
ADMIN_EMAIL="admin@novario.com"
ADMIN_PASSWORD="<strong-admin-password>"
ADMIN_NAME="Admin Master"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxx"
RESEND_FROM_EMAIL="Nova Rio <noreply@novario.com>"

# Payment Gateway (Vindi)
VINDI_API_KEY="<your-vindi-api-key>"
VINDI_API_URL="https://app.vindi.com.br/api/v1"
VINDI_PRODUCT_ID=<product_id>
VINDI_WEBHOOK_USER="<your-vindi-webhook-user>"
VINDI_WEBHOOK_PASSWORD="<your-vindi-webhook-password>"

# Swagger (disable in production or secure it)
ENABLE_SWAGGER=false
SWAGGER_USER="<swagger-user>"
SWAGGER_PASSWORD="<swagger-password>"

# CORS
CORS_ORIGIN="https://app.novario.com"


# Sentry (error monitoring) — leave SENTRY_DSN empty to disable
SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project-id>"
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE=0.1
