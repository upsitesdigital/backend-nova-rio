# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nova_rio
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
# Prisma connection string (derived from values above)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth / Security
JWT_SECRET="jwt-secret"
JWT_EXPIRES_IN="1h"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxx"
RESEND_FROM_EMAIL="Nova Rio <noreply@novario.com>"

