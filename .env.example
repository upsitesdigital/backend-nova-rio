# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nova_rio
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
# Prisma connection string (derived from values above)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Database Pool
DATABASE_POOL_SIZE=10

# Auth / Security
JWT_SECRET="jwt-secret"
JWT_REFRESH_SECRET="jwt-refresh-secret"
JWT_EXPIRES_IN="1h"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Swagger
ENABLE_SWAGGER=true

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxx"
RESEND_FROM_EMAIL="Nova Rio <noreply@novario.com>"

# Payment Gateway (Vindi)
VINDI_API_KEY="your-vindi-api-key"
VINDI_API_URL="https://sandbox-app.vindi.com.br/api/v1"
VINDI_PRODUCT_ID=1

